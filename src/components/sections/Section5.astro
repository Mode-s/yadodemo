---
import { Icon } from 'astro-icon/components';
---
<section class="section contact" id="contact">
  <div class="inner">
    <div class="section-title-wrap">
      <h2 class="title">お問い合わせ</h2>
    </div>

    <p class="contact-lead" data-reveal>
      ご予約・ご質問など、お気軽にお問い合わせください。
    </p>

    <div class="contact-list">
      <!-- 電話 -->
      <a href="tel:000-000-0000" class="contact-item" data-reveal style="--reveal-delay: 80ms">
        <span class="contact-item-icon-wrap">
          <Icon name="mdi:phone" class="contact-item-icon" />
        </span>
        <span class="contact-item-label">お電話</span>
        <span class="contact-item-value">000-000-0000</span>
        <span class="contact-item-note">受付時間 9:00〜18:00</span>
      </a>

      <!-- メール -->
      <a href="mailto:info@example.com" class="contact-item" data-reveal style="--reveal-delay: 160ms">
        <span class="contact-item-icon-wrap">
          <Icon name="mdi:email-outline" class="contact-item-icon" />
        </span>
        <span class="contact-item-label">メール</span>
        <span class="contact-item-value">info@example.com</span>
        <span class="contact-item-note">24時間受付・翌営業日に返信</span>
      </a>

      <!-- LINE -->
      <a href="https://line.me/R/ti/p/YOUR_LINE_ID" target="_blank" rel="noopener noreferrer" class="contact-item" data-reveal style="--reveal-delay: 240ms">
        <span class="contact-item-icon-wrap">
          <Icon name="mdi:chat-outline" class="contact-item-icon" />
        </span>
        <span class="contact-item-label">LINE</span>
        <span class="contact-item-value">友だち追加して送信</span>
        <span class="contact-item-note">チャットで気軽にご相談</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  /* contact-lead */
  .contact-lead {
    margin-top: 16px;
    font-size: $size-sm;
    color: $color-text-light;
    text-align: center;
  }

  /* contact-list */
  .contact-list {
    display: flex;
    gap: 24px;
    margin-top: 40px;

    @include tablet {
      flex-direction: column;
      align-items: center;
    }
  }

  /* contact-item */
  .contact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 8px;
    padding: 32px 20px;
    border: 1px solid $color-border;
    border-radius: 4px;
    text-align: center;
    transition: box-shadow 0.2s ease, transform 0.2s ease;

    &:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }

    @include reduced-motion {
      transition: none;

      &:hover {
        transform: none;
      }
    }

    @include tablet {
      width: 100%;
      max-width: 400px;
    }
  }

  /* contact-item-icon-wrap */
  .contact-item-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: $color-bg-warm;
  }

  /* contact-item-icon */
  .contact-item-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: $color-accent;
    display: block;
  }

  /* contact-item-label */
  .contact-item-label {
    font-size: $size-base;
    font-weight: bold;
    color: $color-primary;
    letter-spacing: 0.05em;
  }

  /* contact-item-value */
  .contact-item-value {
    font-size: $size-sm;
    color: $color-text;
    overflow-wrap: anywhere;
  }

  /* contact-item-note */
  .contact-item-note {
    font-size: $size-xs;
    color: $color-text-light;
  }
</style>