---
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/hero.png';
---

<section class="hero">
  <h1 class="sr-only">山あいの湯宿 静寂庵</h1>
  <div class="hero-inner">
    <figure class="hero-image" data-reveal="hero">
      <Image
        src={heroImg}
        alt="山あいの湯宿 静寂庵の景色"
        width={1320}
        height={800}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;


  /* hero */
  .hero {
    position: relative;
    min-height: 100svh;
  }

  /* hero-inner */
  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
  }

  /* hero-image */
  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
  }
</style>