---
// src/components/Navigation.astro
import { Icon } from 'astro-icon/components';
import { Items } from '../../constants/site-map.ts';
---

<nav>
  <ul class="nav-list">
    {Items.map((item) => {
      // TypeScriptに「これは共通のプロパティだ」と確信させるための安全な代入
      const isExternal = item.isExternal === true;
      const target = isExternal ? "_blank" : undefined;
      const rel = isExternal ? "noopener noreferrer" : undefined;
      
      return (
        <li class="nav-item">
          <a 
            href={item.href}
            target={target}
            rel={rel}
            class="nav-link"
          >
            {item.type === 'icon' ? (
              /* ★修正ポイント: 複数の要素を返すので空タグ <> で囲む */
              <>
                <Icon name={item.iconName} class="nav-icon" />
                <span class="sr-only">{item.label}</span>
              </>
            ) : (
              /* 通常のテキストリンク */
              <span class="text-label">{item.label}</span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  /* スタイル部分は以前の通りでOKです */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>