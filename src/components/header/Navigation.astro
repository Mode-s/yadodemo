---
// src/components/Navigation.astro
import { Icon } from 'astro-icon/components';
import { Items } from '../../constants/site-map.ts';
---

<nav>
  <ul class="nav-list">
    {Items.map((item) => {
      // TypeScriptに「これは共通のプロパティだ」と確信させるための安全な代入
      const isExternal = item.isExternal === true;
      const target = isExternal ? "_blank" : undefined;
      const rel = isExternal ? "noopener noreferrer" : undefined;
      
      return (
        <li class="nav-item">
          <a 
            href={item.href}
            target={target}
            rel={rel}
            class="nav-link"
          >
            {item.type === 'icon' ? (
              /* ★修正ポイント: 複数の要素を返すので空タグ <> で囲む */
              <>
                <Icon name={item.iconName} class="nav-icon" />
                <span class="sr-only">{item.label}</span>
              </>
            ) : (
              /* 通常のテキストリンク */
              <span class="text-label">{item.label}</span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  /* スタイル部分は以前の通りでOKです */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    font-size: $size-sm;
    color: $color-text;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent;
    }

    @include reduced-motion {
      transition: none;
    }
  }

  .nav-icon {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
</style>