---
import { Icon } from 'astro-icon/components';
import { Items } from '../../constants/site-map';
---
<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true" inert>
  <nav class="mobile-menu-nav" aria-label="モバイルナビゲーション">
    <ul class="mobile-menu-list">
      {Items.map((item) => {
        const isExternal = item.isExternal === true;
        const target = isExternal ? '_blank' : undefined;
        const rel = isExternal ? 'noopener noreferrer' : undefined;

        return (
          <li class="mobile-menu-item">
            <a href={item.href} target={target} rel={rel} class="mobile-menu-link">
              {item.type === 'icon' ? (
                <>
                  <Icon name={item.iconName} class="mobile-menu-icon" />
                  <span>{item.label}</span>
                </>
              ) : (
                <span>{item.label}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
    <a href="#reserve" class="mobile-menu-cta">宿泊予約</a>
  </nav>
</div>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  .mobile-menu {
    position: fixed;
    top: 70px;
    left: 0;
    z-index: $z-header - 1;
    width: 100%;
    max-height: calc(100svh - 70px);
    overflow-y: auto;
    padding: 24px 20px 32px;
    background-color: rgba(250, 246, 240, 0.98);
    border-bottom: 1px solid $color-border;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-12px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;

    @media (min-width: #{$tablet + 1px}) {
      display: none;
    }

    @include sp {
      top: 68px;
      max-height: calc(100svh - 68px);
    }

    &.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  .mobile-menu-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .mobile-menu-list {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-item {
    border-bottom: 1px solid $color-border;
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 4px;
    font-size: $size-base;
    color: $color-text;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent;
    }
  }

  .mobile-menu-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .mobile-menu-cta {
    display: block;
    margin-top: 24px;
    padding: 12px 24px;
    background-color: $color-accent;
    color: $color-text-white;
    border-radius: 4px;
    text-align: center;
    font-size: $size-sm;
    letter-spacing: 0.05em;
    transition: background-color 0.2s ease;

    &:hover {
      background-color: $color-accent-dark;
    }
  }

  :global(body.is-menu-open) {
    overflow: hidden;
  }

  @include reduced-motion {
    .mobile-menu,
    .mobile-menu-link,
    .mobile-menu-cta {
      transition: none;
    }
  }
</style>
