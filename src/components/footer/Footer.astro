---
import { Icon } from 'astro-icon/components';
import { Items } from '../../constants/site-map';
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-logo">
      <a href="/" class="footer-logo-link">
        <span class="footer-logo-sub">山あいの湯宿</span>
        <span class="footer-logo-main">静寂庵</span>
      </a>
      <p class="footer-address">〒000-0000 〇〇県〇〇市〇〇町1234</p>
      <p class="footer-tel">TEL. 000-000-0000</p>
    </div>

    <div class="footer-nav-area">
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        <ul class="footer-nav-list">
          {Items.filter((link) => link.type === 'link').map((link) => (
            <li class="footer-nav-item">
              <a href={link.href} class="footer-nav-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        href="https://www.instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-sns"
      >
        <Icon name="mdi:instagram" class="footer-sns-icon" />
        <span class="sr-only">Instagram</span>
      </a>
    </div>
  </div>

  <div class="footer-copyright-wrap">
    <small class="footer-copyright">&copy; 2026 静寂庵 All Rights Reserved.</small>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  /* footer */
  .footer {
    border-top: 1px solid $color-border;
  }

  /* footer-inner */
  .footer-inner {
    @include flex-between;
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 20px;

    @include tablet {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }

  /* ── 左: ロゴ＋住所＋TEL ── */
  .footer-logo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-logo-link {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .footer-logo-sub {
    font-size: $size-xs;
    color: $color-text-light;
  }

  .footer-logo-main {
    font-size: $size-xl;
    font-weight: bold;
    color: $color-primary;
    letter-spacing: 0.1em;
  }

  .footer-address,
  .footer-tel {
    font-size: $size-xs;
    color: $color-text-light;
  }

  /* ── 右: ナビ＋SNS ── */
  .footer-nav-area {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 区切り線「|」を隣接セレクタで挿入 */
  .footer-nav-item + .footer-nav-item::before {
    content: '|';
    margin-right: 8px;
    color: $color-border;
    font-size: $size-xs;
  }

  .footer-nav-link {
    font-size: $size-xs;
    color: $color-text-light;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent;
    }

    @include reduced-motion {
      transition: none;
    }
  }

  /* SNSアイコン */
  .footer-sns {
    @include hover-dim;
  }

  .footer-sns-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: $color-text-light;
  }

  /* ── copyright ── */
  .footer-copyright-wrap {
    text-align: center;
    padding: 16px 20px;
    border-top: 1px solid $color-border;
  }

  .footer-copyright {
    font-size: $size-xs;
    color: $color-text-light;
  }
</style>